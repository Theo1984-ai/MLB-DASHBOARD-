# Secrets — NEVER commit
.streamlit/secrets.toml

# Local data (user-specific, regenerated by the running app)
predictions/*.jsonl
# predictions/calibration.json — INTENTIONALLY committed so the cloud
# uses the same Platt/isotonic params that local training produced.
# Refit locally via: python -m models.calibration
picks/*.json
MLB_homerun_*.csv

# Logs
*.log
streamlit.log
tunnel.log

# Python bytecode + caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
env/
.venv/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Streamlit local cache
.streamlit/cache/

# Local working dirs / caches not needed in repo
.claude/
cache/
tmp/
data/bt_*.json
data/bt_enriched.json
data/bt_hr_actuals.json

# Standalone scripts that import secrets (use the dashboard instead)
pick4.py
tonight_remaining.py
parlay_builder.py

# Standalone backtest / utility scripts — not needed for dashboard deploy
alt_backtest.py
alt_lines.py
alt_spread_prob.py
backtest.py
backtest_blend.py
backtest_live.py
backtest_rr.py
bt_fixed.py
mlb_schedule.py
spread_today.py
spread_value_bets.py
strategy_alt_under.py
strategy_analysis.py
value_bets.py
value_bets_live.py
game_lines_tonight.py
scan_all_markets.py

# HR tracker scripts (local-only — they read secrets and run at module level)
daily_hr_tracker.py
hr_tracker_report.py
hr_compare_and_backtest.py
hr_synthetic_backtest.py
hr_backtest_old_vs_new.py

# Tracker output is local — survives across pushes (don't commit big growing JSON history)
hr_tracker/

# Live pick status + soft-price scanner (local CLI tools — not used by cloud)
nba_pick_status.py
mlb_pick_status.py
mlb_soft_scanner.py
_*.py
# Exception: Python package __init__.py files MUST be tracked even though
# they start with an underscore. Without this, `from scripts.foo import bar`
# can fail intermittently on cloud deployments.
!__init__.py
